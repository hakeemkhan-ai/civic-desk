NODE_ENV=development
# Production Next.js web port. Development stays on port 5173.
PORT=3001
# Enable source-based throttling only behind a verified, normalizing proxy.
# With 0, failures are scoped to accounts; correct passwords remain usable.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/civic_desk
DEMO_ACCOUNTS=true
# Only used by the development seed command. Choose your own password.
DEMO_PASSWORD=demonstration-only-2026
# No key means drafting unavailable and explicitly labeled keyword retrieval.
OPENAI_API_KEY=
DRAFT_MODEL=gpt-4.1-mini-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_MODE=exact
ATLAS_VECTOR_INDEX=complaints_vector_v1
AI_TIMEOUT_MS=15000
AI_DAILY_BUDGET_USD=2
DRAFT_INPUT_USD_PER_MILLION=0.40
DRAFT_OUTPUT_USD_PER_MILLION=1.60
EMBEDDING_USD_PER_MILLION=0.02
# Thresholds are provisional until live development evaluation is run.
DUPLICATE_THRESHOLD=0.76
KEYWORD_THRESHOLD=0.35

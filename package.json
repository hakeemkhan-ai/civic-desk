{
  "name": "civic-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker \"next dev --webpack --hostname 0.0.0.0 --port 5173\" \"node --watch --import tsx server/index.ts\"",
    "dev:db": "node --import tsx scripts/local-mongo.ts",
    "build": "next build --webpack",
    "start": "node scripts/start-next.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "seed": "node --import tsx scripts/seed.ts",
    "eval": "node --import tsx evaluation/run.ts",
    "eval:live": "node --import tsx evaluation/run.ts --live",
    "embeddings:retry": "node --import tsx scripts/reindex.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:unit": "vitest run tests/domain.test.ts tests/ai.test.ts tests/uploads.test.ts tests/http.test.ts tests/worker.test.ts tests/runtime.test.ts",
    "test:integration": "vitest run tests/api.test.ts tests/local-port.test.ts",
    "build:client": "next build --webpack",
    "typecheck:client": "next typegen && tsc --noEmit -p tsconfig.client.json",
    "migrate:hyderabad": "node --import tsx scripts/migrate-hyderabad.ts",
    "worker:start": "node --import tsx server/index.ts",
    "test:next": "node --import tsx scripts/smoke-next.ts",
    "verify:browser-docker": "node --import tsx scripts/verify-browser-docker.ts",
    "verify:browser": "node --import tsx scripts/verify-browser.ts",
    "test:ui:hosted": "node --import tsx scripts/verify-hosted-ui.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "16.6.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.577.0",
    "mongodb": "^6.20.0",
    "next": "16.4.2",
    "openai": "6.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tsx": "4.23.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^6.0.3",
    "concurrently": "10.0.6",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}

{
  "name": "civic-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch --import tsx server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:db": "node --import tsx scripts/local-mongo.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --import tsx scripts/seed.ts",
    "eval": "node --import tsx evaluation/run.ts",
    "eval:live": "node --import tsx evaluation/run.ts --live",
    "embeddings:retry": "node --import tsx scripts/reindex.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:unit": "vitest run tests/domain.test.ts tests/ai.test.ts tests/uploads.test.ts",
    "test:integration": "vitest run tests/api.test.ts tests/local-port.test.ts",
    "build:client": "vite build",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json",
    "migrate:hyderabad": "node --import tsx scripts/migrate-hyderabad.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "0.577.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "openai": "6.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sharp": "0.35.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.6",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.12"
  }
}
